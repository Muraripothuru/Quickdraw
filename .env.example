# PostgreSQL connection strings (required)
# Use Neon or another managed PostgreSQL provider.
# DATABASE_URL may be the pooled connection string used by the app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Use the direct (non-pooler) connection for Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
